{
  "name": "droply-cli",
  "version": "1.0.0",
  "description": "Droply — Zero-Knowledge, End-to-End Encrypted P2P File Transfer CLI",
  "bin": {
    "droply": "./dist/bin/droply.js",
    "droply-cli": "./dist/bin/droply.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && esbuild bin/droply.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/bin/droply.js --external:ws --external:cli-progress --external:commander --external:picocolors --external:qrcode-terminal && chmod +x dist/bin/droply.js",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "bundle": "esbuild bin/droply.ts --bundle --platform=node --target=node20 --outfile=dist/droply.cjs --format=cjs"
  },
  "dependencies": {
    "@droply/protocol": "workspace:*",
    "@droply/server": "workspace:*",
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.10.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
